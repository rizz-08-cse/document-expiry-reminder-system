# Server Configuration
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5180

# Database (MongoDB Atlas / Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/doc_expiry_system

# Authentication
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Scheduling
CRON_SCHEDULE=0 9 * * *
TIMEZONE=Asia/Kolkata

# MSG91 SMS Provider Credentials (Leave empty to enable safe Demo/Simulation mode)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
SMS_SIMULATION_MODE=true

# Admin Seed Bootstrap (used only during initial seed if admin doesn't exist)
ADMIN_DEFAULT_EMAIL=admin@system.local
ADMIN_DEFAULT_PASSWORD=ChangeMeAdmin123!
ADMIN_DEFAULT_PHONE=9999999999
